{
  "name": "portalverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "description": "Open-source, community-built Three.js WebGPU + TSL portal metaverse, made for many authors and their agents",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch packages/server/src/index.ts",
    "start:server": "tsx packages/server/src/index.ts",
    "check:rooms": "node scripts/check-rooms.mjs",
    "build": "npm run check:rooms && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "submit": "node scripts/submit-world.mjs"
  },
  "dependencies": {
    "@ericrius1/cast": "github:ericrius1/weft#dist/cast",
    "@ericrius1/weft": "git+https://github.com/ericrius1/weft.git#dist/weft",
    "three": "^0.187.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.1",
    "@webgpu/types": "^0.1.74",
    "concurrently": "^9.1.2",
    "leva": "^0.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
