{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@portalverse/core": ["packages/core/src/index.ts"],
      "@portalverse/core/*": ["packages/core/src/*"],
      "@portalverse/worlds/*": ["worlds/*"],
      "@portalverse/server/*": ["packages/server/src/*"]
    }
  },
  "include": [
    "app/**/*",
    "packages/**/*",
    "worlds/**/*",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
